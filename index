    padding: 64px 0;
  }
  .hero {
    padding: 128px 0 72px;
  }
  .hero h1 {
    font-size: clamp(30px, 8.5vw, 38px);
    line-height: 1.12;
  }
  .hero p.lead {
    font-size: 16px;
  }
  .hero-cta {
    flex-direction: column;
    align-items: stretch;
  }
  .hero-cta .btn {
    width: 100%;
    padding: 15px 20px;
    font-size: 15px;
  }
  .trust-line {
    font-size: 12px;
    line-height: 1.5;
